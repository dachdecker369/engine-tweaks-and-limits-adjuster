root = true

[*]
charset = utf-8
insert_final_newline = true

# TweaksV's own code and the test programs
[{source,test}/*.{cpp,h}]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true

[*.{md,ini,vcxproj,filters,slnx}]
indent_style = space
indent_size = 2

# vendor/ holds third-party source exactly as released: never reformat
[vendor/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
