// SPDX-License-Identifier: GPL-3.0-only
// Version resource of TweaksV.asi, shown in Explorer > Properties > Details. The numbers come
// from BuildInfo.h, which TweaksV.vcxproj writes into object\ before every build.
#include <winver.h>
#include "BuildInfo.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TWEAKSV_VERSION_MAJOR,TWEAKSV_VERSION_MINOR,TWEAKSV_VERSION_PATCH,0
 PRODUCTVERSION TWEAKSV_VERSION_MAJOR,TWEAKSV_VERSION_MINOR,TWEAKSV_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "TweaksV"
      VALUE "FileDescription", "TweaksV - ASI plugin for GTA V Enhanced"
      VALUE "InternalName", "TweaksV"
      VALUE "OriginalFilename", "TweaksV.asi"
      VALUE "FileVersion", TWEAKSV_VERSION
      VALUE "ProductVersion", TWEAKSV_VERSION
      VALUE "LegalCopyright", "Copyright (C) dachdecker369. Licensed under GPL-3.0-only - see LICENSE."
      VALUE "Comments", "Based on plugins by Chiheb-Bacha and others - see CREDITS.md"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
