// SPDX-License-Identifier: GPL-3.0-only
// Version resource for the fake game: the game build it pretends to be (rc /dVER_C=... /dVER_D=...).
#include <winver.h>
#ifndef VER_C
#define VER_C 1158
#endif
#ifndef VER_D
#define VER_D 16
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,VER_C,VER_D
 PRODUCTVERSION 1,0,VER_C,VER_D
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TweaksV test harness"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
